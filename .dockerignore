# Build context: only what the Dockerfile copies, plus the small top-level files. Never .env (secrets).
.git
**/.git
.env
*.env
machine-emulator/*
!machine-emulator/doc
machine-emulator/doc/*
!machine-emulator/doc/recipes
machine-emulator/doc/recipes/*
!machine-emulator/doc/recipes/*.lua
handler/test.lua
handler/test.sh

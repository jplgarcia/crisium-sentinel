# Required
RPC_URL=https://ethereum-rpc.example/your-key        # Ethereum JSON-RPC (HTTP); must serve eth_getLogs and finalized blocks
APPLICATION=0x0000000000000000000000000000000000000000  # the application contract
TEMPLATE_URL=https://example.com/app-template.tar.gz # .tar.gz of the stored template machine, from the app team

# Recommended
TEMPLATE_SHA256=                                     # SHA-256 of the tarball, from the app team
LABEL=sentinel                                       # name in logs and alerts
CRISIUM_ALERTS_WEBHOOK=                              # Discord (or Slack) webhook; empty = log only
CRISIUM_ALERTS_WEBHOOK_MIN=warn                      # guardian | operator | warn | self
CRISIUM_ALERTS_WEBHOOK_FORMAT=discord                # discord | slack
CRISIUM_ALERTS_RUNBOOK=                              # runbook URL per alarm, {kind} is replaced

# Optional
WS_URL=                                              # the provider's WebSocket endpoint (new heads), instead of polling
WARNING_BLOCKS=                                      # crisium --warning-blocks (default 10)
FIRST_EPOCH=                                         # crisium --first-epoch (default 0)
POLL_INTERVAL=                                       # crisium --poll-interval in seconds (default 1)
CRISIUM_ARGS=                                        # any other crisium options, space separated
STATUS_MAX_AGE=300                                   # healthcheck: seconds without a finished pass
